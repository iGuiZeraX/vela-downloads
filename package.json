{
  "name": "vela-downloads",
  "productName": "Vela",
  "version": "0.2.1",
  "description": "Seus downloads, no seu ritmo. Gerenciador aberto para Windows.",
  "main": "src/main.cjs",
  "license": "MIT",
  "private": true,
  "author": "Vela contributors",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
